{
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev": "npx concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "build": "npm run build --workspaces",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" \"*.{json,md,yml,yaml}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}
